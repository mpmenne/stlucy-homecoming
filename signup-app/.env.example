# Copy to .env and fill in. .env is gitignored — never commit it.

# The ID from the sheet's URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=your-google-sheet-id

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=change-me

# Tab names (defaults shown) — only set if the sheet's tabs are renamed.
# MATRIX_TAB=Volunteer Matrix
# SIGNUPS_TAB=Signups

# Only needed when running OUTSIDE docker (docker-compose sets the container path).
# GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
